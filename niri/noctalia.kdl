layout {

    focus-ring {
        active-color   "#d9c498"
        inactive-color "#151310"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#d9c498"
        inactive-color "#151310"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#d9c498"
        inactive-color "#a18f66"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#d9c49880"
    }
}

recent-windows {
    highlight {
        active-color "#d9c498"
        urgent-color "#ffb4ab"
    }
}
